---
import Base from '../layouts/Base.astro';
---
<Base title="Growth Plans - Aurevo">
  <div class="min-h-screen bg-dark">
    <header class="border-b border-white/5 px-6 py-4 flex items-center justify-between max-w-6xl mx-auto">
      <a href="/dashboard" class="text-sm text-soft/70 hover:text-white flex items-center gap-2">&larr; Dashboard</a>
      <span class="text-xl font-semibold text-white">Aurevo</span>
    </header>

    <main class="max-w-6xl mx-auto px-6 py-10">
      <div class="text-center max-w-xl mx-auto mb-12">
        <h1 class="text-3xl font-semibold text-white mb-2">Membership & Growth Plans</h1>
        <p class="text-soft/50 text-sm">Upgrade your tier to unlock higher task payouts and active savings returns</p>
      </div>

      <div id="plansGrid" class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <!-- Plans will be loaded via script -->
      </div>
    </main>
  </div>
</Base>

<script>
  async function loadPlans() {
    try {
      const res = await fetch('https://aurevo-api.kawunlere.workers.dev/api/plans');
      const plans = await res.json();
      const grid = document.getElementById('plansGrid');

      grid.innerHTML = plans.map(p => `
        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 flex flex-col justify-between hover:border-gold/30 transition-colors">
          <div>
            <span class="text-xs font-semibold text-gold uppercase tracking-wider block mb-2">${p.name}</span>
            <p class="text-3xl font-semibold text-white mb-6">₦${p.price.toLocaleString()}<span class="text-xs text-soft/40 font-normal">/mo</span></p>

            <ul class="space-y-3 text-xs text-soft/70 mb-8">
              <li class="flex items-center gap-2">
                <svg class="w-4 h-4 text-gold shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                ${p.taskLimit}
              </li>
              <li class="flex items-center gap-2">
                <svg class="w-4 h-4 text-gold shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                ${p.commissionRate} payout multiplier
              </li>
              <li class="flex items-center gap-2">
                <svg class="w-4 h-4 text-gold shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                ${p.savingsAccess ? 'Savings Circle Enabled' : 'No Savings Access'}
              </li>
            </ul>
          </div>

          <button onclick="subscribe('${p.id}', '${p.name}')" class="w-full bg-gold/10 hover:bg-gold text-gold hover:text-dark font-medium py-2.5 rounded-lg transition-colors text-xs">
            ${p.price === 0 ? 'Current Plan' : 'Subscribe Now'}
          </button>
        </div>
      `).join('');
    } catch {
      console.error('Failed to load plans');
    }
  }

  window.subscribe = async (planId, planName) => {
    const userStr = localStorage.getItem('aurevo_user');
    if (!userStr) {
      window.location.href = '/login';
      return;
    }
    const user = JSON.parse(userStr);

    if (!confirm(`Confirm subscription to ${planName}?`)) return;

    try {
      const res = await fetch('https://aurevo-api.kawunlere.workers.dev/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userId: user.id, planId })
      });
      const json = await res.json();
      if (json.success) {
        alert(json.message);
        window.location.href = '/dashboard';
      } else {
        alert(json.error || 'Subscription failed');
      }
    } catch {
      alert('Connection error. Try again.');
    }
  };

  loadPlans();
</script>
