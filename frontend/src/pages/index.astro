---
import Base from '../layouts/Base.astro';
---
<Base title="Aurevo - Grow Your Wealth">
  <nav class="flex items-center justify-between px-6 py-5 max-w-6xl mx-auto">
    <h1 class="text-2xl font-semibold tracking-tight text-white">Aurevo</h1>
    <div class="flex gap-4">
      <a href="/login" class="text-sm text-soft/70 hover:text-white transition-colors duration-300">Log in</a>
      <a href="/register" class="text-sm bg-gold/10 text-gold px-4 py-2 rounded-lg hover:bg-gold/20 transition-colors duration-300">Get Started</a>
    </div>
  </nav>

  <main class="max-w-6xl mx-auto px-6 pt-20 pb-32">
    <div class="text-center max-w-2xl mx-auto">
      <p class="text-gold text-sm font-medium tracking-widest uppercase mb-4">Smart Earnings Platform</p>
      <h2 class="text-4xl md:text-5xl font-semibold text-white leading-tight mb-6">
        Earn. Save. Grow.<br />All in One Place.
      </h2>
      <p class="text-soft/60 text-lg leading-relaxed mb-10">
        Complete simple tasks, join savings circles, and watch your money grow. Built for people who want real results.
      </p>
      <a href="/register" class="inline-block bg-gold text-dark font-medium px-8 py-3 rounded-lg hover:bg-gold/90 transition-colors duration-300">
        Create Free Account
      </a>
    </div>

    <div class="grid md:grid-cols-3 gap-6 mt-24">
      <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-8">
        <svg class="w-8 h-8 text-gold mb-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 00.75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 00-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0112 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 01-.673-.38m0 0A2.18 2.18 0 013 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 013.413-.387m7.5 0V5.25A2.25 2.25 0 0013.5 3h-3a2.25 2.25 0 00-2.25 2.25v.894m7.5 0a48.667 48.667 0 00-7.5 0" />
        </svg>
        <h3 class="text-white font-medium text-lg mb-2">Daily Tasks</h3>
        <p class="text-soft/50 text-sm leading-relaxed">Complete quick tasks and earn real money every single day.</p>
      </div>

      <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-8">
        <svg class="w-8 h-8 text-gold mb-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z" />
        </svg>
        <h3 class="text-white font-medium text-lg mb-2">Growth Plans</h3>
        <p class="text-soft/50 text-sm leading-relaxed">Subscribe to a plan and earn passive returns on your savings.</p>
      </div>

      <div class="bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-8">
        <svg class="w-8 h-8 text-gold mb-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
        </svg>
        <h3 class="text-white font-medium text-lg mb-2">Referral Rewards</h3>
        <p class="text-soft/50 text-sm leading-relaxed">Invite friends and earn commission from every task they complete.</p>
      </div>
    </div>
  </main>

  <footer class="border-t border-white/5 py-8 text-center">
    <p class="text-soft/30 text-sm">Aurevo. All rights reserved.</p>
  </footer>
</Base>
